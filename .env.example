# Twitch chat integration.
# Copy this file to .env and fill in the value. Vite only exposes vars prefixed with VITE_.

# Channel to listen to, without the # sign. Any channel can be used, it does not have
# to belong to the app owner. The game connects anonymously and only reads messages,
# so no Client ID or Client Secret is required and nothing secret ends up in the
# browser bundle.
VITE_TWITCH_CHANNEL=

# Your own Twitch user ID (a number, not the login name). Only this user can run the
# load-testing commands below, so viewers cannot flood the overlay with bots.
# How to find it: open your channel page, the number in the page URL is the user ID.
# Leave empty to disable the commands entirely.
VITE_TWITCH_OWNER_ID=
